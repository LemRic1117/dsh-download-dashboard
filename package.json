{
  "name": "dsh-download-dashboard",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "悬浮在 DSH 对话区右侧的大文件下载看板：任何遵守状态文件约定的下载器，无论跑在主会话、子代理还是你自己的终端里，都会被同一块浮窗看见。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LemRic1117/dsh-download-dashboard.git"
  },
  "icon": "./icon.svg",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE",
    "tools/dl.ps1"
  ],
  "meta": {
    "title": "下载看板",
    "description": "对话区右侧的悬浮看板，只列 300MB 以上的下载，跨会话、跨子代理、跨终端可见。"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-layout"]
    }
  }
}
